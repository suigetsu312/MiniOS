{
  "version": 4,
  "configurations": [
    {
      "name": "MiniOS (riscv32)",
      "compilerPath": "/usr/bin/clang",
      "compilerArgs": [
        "--target=riscv32-unknown-elf",
        "-ffreestanding",
        "-fno-stack-protector",
        "-nostdinc",
        "-I${workspaceFolder}/include"
      ],
      "includePath": [
        "${workspaceFolder}/include"
      ],
      "defines": [
        "__riscv",
        "__riscv_xlen=32"
      ],
      "cStandard": "c11",
      "intelliSenseMode": "linux-clang-x64"
    }
  ]
}
